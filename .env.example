# ============================================
# CHRONOS Store — environment template
# Copy to .env.local and fill in. Never commit it.
# ============================================

# === The bot's DASH API (catalog + key delivery) ===
# DASH_API_URL is the same tunnel URL the CHRONOS-Dashboard uses, and
# DASH_API_TOKEN must match the bot's .env. Both stay server-side.
DASH_API_URL=
DASH_API_TOKEN=
# The Discord server ID whose config holds the products/categories.
CHRONOS_GUILD_ID=

# === Discord OAuth2 (buyer login) ===
# The same Discord application as the dashboard is fine — just add this
# redirect URI in the Developer Portal: https://your-store.vercel.app/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated Discord user IDs allowed to open /admin (release keys, promo, settings).
STORE_ADMIN_DISCORD_IDS=

# === Supabase (optional) ===
# Without these the store runs on an in-memory store: orders vanish on restart.
# Run supabase/schema.sql in the SQL editor, and use the SERVICE ROLE key —
# it must never get a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Optional ===
# Shown in the header, footer and page title.
STORE_NAME=CHRONOS Store
